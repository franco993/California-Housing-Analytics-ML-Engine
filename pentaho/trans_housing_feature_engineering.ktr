<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>trans_housing_feature_engineering</name>
    <description>Transformacion de Feature Engineering para Housing Analytics</description>
    <extended_description/>
    <trans_version>1.0</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <log>
    </log>
    <maxdate>
      <connection/>
      <table/>
      <field/>
      <offset>0.0</offset>
      <maxdiff>0.0</maxdiff>
    </maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/10/08 16:30:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/08 16:30:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <connection>
    <name>MySQL_Housing_DB</name>
    <server>localhost</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>housing_db</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
  </connection>
  <order>
    <hop>
      <from>CSV file input - Raw Housing Data</from>
      <to>Calculator - Feature Engineering</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calculator - Feature Engineering</from>
      <to>Select values - Data Types &amp; Rename</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select values - Data Types &amp; Rename</from>
      <to>Table output - Housing Processed Staging</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>CSV file input - Raw Housing Data</name>
    <type>CsvInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${PROJECT_ROOT}/data/housing.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>Y</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>longitude</name>
        <type>Number</type>
        <format>#.00</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>9</length>
        <precision>2</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>latitude</name>
        <type>Number</type>
        <format>#.00</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>9</length>
        <precision>2</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>housing_median_age</name>
        <type>Number</type>
        <format>#</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>5</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>total_rooms</name>
        <type>Number</type>
        <format>#</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>7</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>total_bedrooms</name>
        <type>Number</type>
        <format>#</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>7</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>population</name>
        <type>Number</type>
        <format>#</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>7</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>households</name>
        <type>Number</type>
        <format>#</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>7</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>median_income</name>
        <type>Number</type>
        <format>#.0000</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>7</length>
        <precision>4</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>median_house_value</name>
        <type>Number</type>
        <format>#.00</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>10</length>
        <precision>2</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>ocean_proximity</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>30</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>120</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Calculator - Feature Engineering</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <failIfNoFile>Y</failIfNoFile>
    <calculation>
      <field_name>rooms_per_household</field_name>
      <calc_type>DIVIDE</calc_type>
      <field_a>total_rooms</field_a>
      <field_b>households</field_b>
      <field_c/>
      <value_type>Number</value_type>
      <value_length>10</value_length>
      <value_precision>4</value_precision>
      <remove>N</remove>
      <conversion_mask>#.0000</conversion_mask>
      <decimal_symbol>.</decimal_symbol>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>bedrooms_per_room</field_name>
      <calc_type>DIVIDE</calc_type>
      <field_a>total_bedrooms</field_a>
      <field_b>total_rooms</field_b>
      <field_c/>
      <value_type>Number</value_type>
      <value_length>10</value_length>
      <value_precision>4</value_precision>
      <remove>N</remove>
      <conversion_mask>#.0000</conversion_mask>
      <decimal_symbol>.</decimal_symbol>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>population_per_household</field_name>
      <calc_type>DIVIDE</calc_type>
      <field_a>population</field_a>
      <field_b>households</field_b>
      <field_c/>
      <value_type>Number</value_type>
      <value_length>10</value_length>
      <value_precision>4</value_precision>
      <remove>N</remove>
      <conversion_mask>#.0000</conversion_mask>
      <decimal_symbol>.</decimal_symbol>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <attributes/>
    <GUI>
      <xloc>360</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Select values - Data Types &amp; Rename</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>longitude</name>
        <rename/>
      </field>
      <field>
        <name>latitude</name>
        <rename/>
      </field>
      <field>
        <name>housing_median_age</name>
        <rename/>
      </field>
      <field>
        <name>total_rooms</name>
        <rename/>
      </field>
      <field>
        <name>total_bedrooms</name>
        <rename/>
      </field>
      <field>
        <name>population</name>
        <rename/>
      </field>
      <field>
        <name>households</name>
        <rename/>
      </field>
      <field>
        <name>median_income</name>
        <rename/>
      </field>
      <field>
        <name>median_house_value</name>
        <rename/>
      </field>
      <field>
        <name>ocean_proximity</name>
        <rename/>
      </field>
      <field>
        <name>rooms_per_household</name>
        <rename/>
      </field>
      <field>
        <name>bedrooms_per_room</name>
        <rename/>
      </field>
      <field>
        <name>population_per_household</name>
        <rename/>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>620</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Table output - Housing Processed Staging</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MySQL_Housing_DB</connection>
    <schema/>
    <table>stg_housing_processed</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>